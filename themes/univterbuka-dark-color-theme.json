  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7E93B0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FFE95C"
      }
    },
    {
      "name": "Number / Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFB86B"
      }
    },
    {
      "name": "Keyword / Control",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#79B8FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#FFDE00"
      }
    },
    {
      "name": "Type / Class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6ED3D8"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#EAF0F8"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C7D3E6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#A9D1FF"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#79B8FF"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFE95C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator / Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#9FB0C6"
      }
    },
    {
      "name": "Preprocessor / Annotation",
      "scope": [
        "meta.preprocessor",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#FFDE00"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FF8A80"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#17202A",
        "background": "#FF8A80"
      }
    },
    {
      "name": "Markup Heading",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#FFDE00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#79B8FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Inline Code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#FFE95C"
      }
    },
    {
      "name": "JSON Key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#A9D1FF"
      }
    },
    {
      "name": "JSON String",
      "scope": [
        "string.quoted.double.json"
      ],
      "settings": {
        "foreground": "#FFE95C"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#7E93B0",
      "italic": true
    },
    "keyword": {
      "foreground": "#79B8FF",
      "bold": true
    },
    "string": {
      "foreground": "#FFE95C"
    },
    "number": {
      "foreground": "#FFB86B"
    },
    "function": {
      "foreground": "#FFDE00"
    },
    "class": {
      "foreground": "#6ED3D8"
    },
    "type": {
      "foreground": "#6ED3D8"
    },
    "parameter": {
      "foreground": "#C7D3E6",
      "italic": true
    },
    "property": {
      "foreground": "#A9D1FF"
    },
    "variable": {
      "foreground": "#EAF0F8"
    }
  }
}